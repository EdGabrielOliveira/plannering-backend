# Configurações de Segurança para Planner API
# Copie este arquivo para .env e configure as variáveis

# JWT Secret - OBRIGATÓRIO: Use uma string aleatória complexa
# Gere com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_jwt_muito_complexa_aqui

# Expiração do JWT (recomendado: 1h para produção)
JWT_EXPIRES_IN=1h

# Configuração do banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/planner_db"

# Configuração do CORS (liste apenas as origens permitidas)
CORS_ORIGIN=http://localhost:3000,https://seudominio.com

# Porta da aplicação
PORT=3001

# Ambiente (production, development, test)
NODE_ENV=development

# Configuração do Swagger (apenas para desenvolvimento)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=Planner API
SWAGGER_DESCRIPTION=API para gerenciamento de tarefas
SWAGGER_VERSION=1.0

# Para produção, sempre configurar:
# NODE_ENV=production
# SWAGGER_ENABLED=false
# JWT_EXPIRES_IN=1h
# CORS_ORIGIN=https://seudominio.com (apenas domínios confiáveis)
