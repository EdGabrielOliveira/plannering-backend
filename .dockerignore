generated/
*.dll.node
query_engine-*
.prisma/

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git (reduz contexto significativamente)
.git
.gitignore

# Documentation (não necessário em produção)
README.md
docs
*.md

# Testing (não necessário em produção)
