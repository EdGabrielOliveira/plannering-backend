# Configuração para Heroku
NODE_ENV=production
PORT=3000

# Database - configurar no Heroku com add-on PostgreSQL
# DATABASE_URL será fornecida automaticamente pelo Heroku

# JWT - configurar nas Config Vars do Heroku
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=1h

# API Keys - configurar nas Config Vars do Heroku
# WEB_API_KEY=your_web_api_key_here
# MOBILE_API_KEY=your_mobile_api_key_here

# CORS - configurar com o domínio do Heroku
# CORS_ORIGIN=https://your-frontend.herokuapp.com

# Swagger - desabilitado em produção
SWAGGER_ENABLED=false
